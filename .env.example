# ============================================================
# Exaltis SaaS — Environment Variables
# Provided by Uion Solutions LLC
# ============================================================

# Public site
NEXT_PUBLIC_SITE_URL=https://exaltis.org
NEXT_PUBLIC_BRAND_NAME=Exaltis
NEXT_PUBLIC_COMPANY=Uion Solutions LLC

# Database (Postgres recommended in production)
DATABASE_URL="postgresql://user:password@localhost:5432/exaltis?schema=public"

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_PRICE_CORE=price_xxx
STRIPE_PRICE_CORE_PLUS=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
# One-time setup fee ($199.99) — added as a one-shot line item at checkout
STRIPE_PRICE_SETUP_FEE=price_xxx

# Email (transactional)
RESEND_API_KEY=
SUPPORT_EMAIL=hello@exaltis.org

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
